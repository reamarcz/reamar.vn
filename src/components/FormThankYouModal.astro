---
---
<div
  id="form-thankyou-overlay"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
  data-form-thankyou
>
  <div
    class="relative w-[94vw] max-w-[1000px] max-h-[90vh] overflow-y-auto bg-white rounded-none shadow-none scale-95 transition-all duration-200 border border-gray-200"
    role="dialog"
    aria-labelledby="form-thankyou-title"
    aria-modal="true"
    tabindex="-1"
    data-form-thankyou-modal
    onclick="event.stopPropagation()"
  >
    <div class="p-10 md:p-14 lg:p-16">
      <button
        type="button"
        class="absolute top-8 right-8 flex items-center gap-2 border-0 bg-transparent p-0 font-yellix text-[14px] font-normal text-gray-500 cursor-pointer hover:text-gray-700 transition-colors"
        aria-label="Zavřít"
        data-form-thankyou-close
      >
        <span>Zavřít</span>
        <span class="text-[#000000]" aria-hidden="true">×</span>
      </button>

      <h2 id="form-thankyou-title" class="font-yellix text-[27px] font-normal text-[#000000] pr-20 mb-6">Děkujeme</h2>
      <p class="font-yellix text-[14px] font-normal text-[#000000] mb-4">
        Váš záměr jsme přijali ke zpracování.
      </p>
      <p class="font-yellix text-[14px] font-normal text-[#000000] mb-4">
        Na uvedené údaje se vám už brzy ozveme s prvním návrhem spolupráce.
      </p>
      <p class="font-yellix text-[14px] font-normal text-[#000000] mb-8">
        Pokud s námi chcete mluvit dříve, rádi vás uslyšíme na čísle <a href="tel:+420607066044" class="text-[#000000] underline hover:opacity-80">+420 607 066 044</a>.
      </p>
      <a href="tel:+420607066044" class="inline-flex items-center gap-1.5 bg-[#000000] text-white font-yellix text-[14px] font-normal py-2 px-3 border-0 cursor-pointer hover:opacity-90 transition-opacity no-underline w-fit">
        <span>Zavolat</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
      <p class="mt-6">
        <button type="button" class="font-yellix text-[14px] font-normal text-[#000000] underline bg-transparent border-0 cursor-pointer p-0 hover:opacity-80 transition-opacity" data-form-thankyou-close>zavřít</button>
      </p>
    </div>
  </div>
</div>

<script>
  function initFormThankYouModal() {
    const overlay = document.getElementById('form-thankyou-overlay');
    const modal = document.querySelector('[data-form-thankyou-modal]');
    if (!overlay && !modal) return;

    function openModal() {
      if (!overlay || !modal) return;
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.classList.remove('scale-95');
      modal.classList.add('scale-100');
      modal.focus();
    }

    function closeModal() {
      if (!overlay || !modal) return;
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      modal.classList.remove('scale-100');
      modal.classList.add('scale-95');
      window.dispatchEvent(new CustomEvent('smart-modal-closed'));
    }

    overlay?.addEventListener('click', closeModal);
    document.querySelectorAll('[data-form-thankyou-close]').forEach(function (btn) {
      btn.addEventListener('click', closeModal);
    });
    modal?.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    if (window.__formThankYouOpenModalHandler) {
      window.removeEventListener('form-thank-you-show', window.__formThankYouOpenModalHandler);
    }
    window.__formThankYouOpenModalHandler = openModal;
    window.addEventListener('form-thank-you-show', openModal);
  }
  initFormThankYouModal();
  document.addEventListener('astro:page-load', initFormThankYouModal);
</script>
