---
interface Props {
  ctaLabel?: string;
  ctaHref?: string;
}

const { ctaLabel = 'Jak to funguje', ctaHref = '/sluzby' } = Astro.props;

const cards = [
  {
    title: 'Vyhledávání na celém trhu novostaveb',
    text: 'V Praze sledujeme téměř deset tisíc jednotek napříč stovkami developerských projektů.',
    icon: 'search',
    offset: '',
  },
  {
    title: 'Zvýhodněné podmínky u developerů',
    text: 'Díky kontaktům na developerském trhu řešíme předprodeje, neveřejné nabídky a podmínky, ke kterým se kupující sám často nedostane.',
    icon: 'reserve',
    offset: 'lg:mt-8',
  },
  {
    title: 'Komunikace s developerem a právní servis',
    text: 'Od rezervace po podpis smluv stojíme na vaší straně. Hlídáme podmínky, termíny, dokumentaci i body, které se v nákupu snadno přehlédnou.',
    icon: 'deal',
    offset: '',
  },
];
---

<section id="koncept" class="bg-[var(--color-muted)]" aria-labelledby="koncept-heading" data-koncept>
  <div class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-20 xl:px-14 xl:py-24">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-x-12">
      <div class="lg:col-span-5">
        <h2
          id="koncept-heading"
          class="koncept-copy whitespace-nowrap font-yellix text-[28px] font-medium leading-[1.12] tracking-[-0.02em] text-black md:text-[36px] xl:text-[40px]"
          style="--copy-i: 0"
        >
          Koncept Buyer’s Agency
        </h2>
        <p class="koncept-copy mt-5 max-w-[36ch] font-yellix text-[16px] font-medium leading-[1.45] text-black md:text-[18px]" style="--copy-i: 1">
          Buyer’s agent je na západních trzích běžný princip odborného <span class="font-medium">zastoupení kupujícího</span>.
        </p>
        <p class="koncept-quote koncept-copy mt-8 ml-6 max-w-[40ch] font-yellix text-[14px] font-medium leading-[1.55] text-black/75 md:ml-10 md:text-[15px]" style="--copy-i: 2">
          Klient má při nákupu nemovitosti partnera, který nestojí na straně konkrétní nabídky, ale na straně jeho rozhodnutí. Tento přístup přinášíme do Prahy se specializací na developerské projekty.
        </p>
      </div>

      <div class="flex flex-col lg:col-span-7">
        <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-3" data-koncept-cards>
          {cards.map((card) => (
            <article class:list={['koncept-card flex flex-col', card.offset]}>
              <span class:list={['koncept-icon', `koncept-icon--${card.icon}`]} aria-hidden="true">
                {card.icon === 'search' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.2"/>
                    <path d="M16.2 16.2 21 21"/>
                  </svg>
                )}
                {card.icon === 'reserve' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="5" width="16" height="15" rx="0"/>
                    <path d="M4 10h16M8 3v4M16 3v4"/>
                  </svg>
                )}
                {card.icon === 'deal' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 4h10v16H7z"/>
                    <path d="M10 8h4M10 12h4M10 16h2.5"/>
                  </svg>
                )}
              </span>
              <h3 class="koncept-card-title mt-5 font-yellix text-[20px] font-medium leading-[1.15] tracking-[-0.02em] text-black md:text-[22px]">
                {card.title}
              </h3>
              <p class="mt-3 font-yellix text-[14px] font-medium leading-[1.5] text-black/70 md:text-[15px]">
                {card.text}
              </p>
            </article>
          ))}
        </div>
        <a
          href={ctaHref}
          class="mt-6 -mr-1 self-end inline-flex items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-white no-underline whitespace-nowrap transition-opacity hover:opacity-85 lg:-mr-5"
        >
          <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .koncept-copy {
    opacity: 0;
    transform: translateY(16px);
  }
  .koncept-copy.is-in {
    animation: koncept-copy-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--copy-i) * 140ms);
  }
  @keyframes koncept-copy-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .koncept-quote {
    padding-left: 1rem;
    border-left: 1px solid rgba(0, 0, 0, 0.18);
  }
  .koncept-card {
    background: #fff;
    padding: 1.4rem 1.2rem 1.55rem;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.04);
    opacity: 0;
    transform: translateY(24px);
  }
  .koncept-card.is-in {
    animation: koncept-punch 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes koncept-punch {
    0% { opacity: 0; transform: translateY(24px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .koncept-icon {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 40px;
    height: 40px;
    color: #000;
    flex-shrink: 0;
    overflow: visible;
  }
  .koncept-icon svg {
    width: 32px;
    height: 32px;
    transform-origin: center;
  }
  .koncept-card.is-in .koncept-icon--search svg {
    animation: koncept-icon-search 7.5s ease-in-out infinite;
  }
  .koncept-card.is-in .koncept-icon--reserve svg {
    animation: koncept-icon-reserve 7.5s ease-in-out infinite;
  }
  .koncept-card.is-in .koncept-icon--deal svg {
    animation: koncept-icon-deal 7.5s ease-in-out infinite;
  }
  @keyframes koncept-icon-search {
    0%, 10%, 100% { transform: scale(1); }
    5% { transform: scale(1.48); }
  }
  @keyframes koncept-icon-reserve {
    0%, 32%, 46%, 100% { transform: rotate(0deg); }
    36% { transform: rotate(-30deg); }
    41% { transform: rotate(22deg); }
    45% { transform: rotate(0deg); }
  }
  @keyframes koncept-icon-deal {
    0%, 64%, 80%, 100% { transform: translateY(0); }
    68% { transform: translateY(-11px); }
    72% { transform: translateY(0); }
    75% { transform: translateY(-5px); }
    79% { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .koncept-copy,
    .koncept-card {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .koncept-icon svg {
      animation: none;
    }
  }
</style>

<script>
  function initKoncept() {
    const wrap = document.querySelector('[data-koncept]');
    const grid = wrap && wrap.querySelector('[data-koncept-cards]');
    if (!wrap || !grid) return;
    if (wrap._konceptCleanup) wrap._konceptCleanup();

    const copy = [...wrap.querySelectorAll('.koncept-copy')];
    const cards = [...grid.querySelectorAll('.koncept-card')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      copy.forEach((el) => el.classList.add('is-in'));
      cards.forEach((card) => card.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        copy.forEach((el) => el.classList.add('is-in'));
        cards.forEach((card, index) => {
          window.setTimeout(() => card.classList.add('is-in'), 420 + index * 120);
        });
        io.disconnect();
      },
      { threshold: 0.12 }
    );

    io.observe(wrap);

    wrap._konceptCleanup = () => {
      io.disconnect();
      wrap._konceptCleanup = null;
    };
  }

  initKoncept();
  document.addEventListener('astro:page-load', initKoncept);
</script>
