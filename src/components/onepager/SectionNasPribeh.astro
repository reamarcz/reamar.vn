---
interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = '/#ve-chung-toi', ctaLabel = 'Câu chuyện của chúng tôi' } = Astro.props;
const ctaExternal = ctaHref.startsWith('http');
const image = '/images/agency/George_14.jpg';
const lines = [
  { text: 'Trước hết cho chính mình.', em: false, indent: 0 },
  { text: 'Sau đó cho gia đình.', em: false, indent: 1 },
  { text: 'Hôm nay cho khách hàng.', em: false, indent: 2 },
];
---

<section id="ve-chung-toi" class="pribeh-section relative w-full overflow-hidden" aria-labelledby="pribeh-heading" data-pribeh>
  <div class="pribeh-media relative h-[95svh] min-h-[700px] max-h-none w-full md:h-[64vh] md:min-h-[520px] md:max-h-[760px]">
    <img
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[center_42%] md:object-[center_56%]"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="pribeh-scrim pointer-events-none absolute inset-x-0 bottom-0 h-[42%] md:hidden" aria-hidden="true"></div>

    <div class="relative mx-auto flex h-full max-w-[1440px] items-end px-5 pb-3 pt-8 md:items-center md:px-10 md:py-12 xl:px-14 xl:py-14">
      <div class="flex w-full max-w-[32rem] flex-col gap-8 md:gap-10">
        <h2
          id="pribeh-heading"
          class="font-yellix text-[22px] font-medium leading-[1.18] tracking-[-0.02em] text-white md:text-[28px] xl:text-[32px] [text-shadow:0_1px_16px_rgba(0,0,0,0.35)]"
        >
          {lines.map((line, index) => (
            <span
              class:list={['pribeh-line', line.em && 'pribeh-em']}
              style={`--i: ${index}; --indent: ${line.indent}`}
            >
              {line.text}
            </span>
          ))}
        </h2>

        <div class="pribeh-body">
          <p class="font-yellix text-[14px] font-medium leading-[1.55] text-white md:text-[15px] [text-shadow:0_1px_12px_rgba(0,0,0,0.4)]">
            Chúng tôi hoạt động lâu dài trên thị trường chủ đầu tư và cũng tự mình mua trên thị trường đó. Dần dần, chúng tôi bắt đầu giúp gia đình, người thân và những người xung quanh theo cùng cách đó.
          </p>
          <p class="mt-4 font-yellix text-[14px] font-medium leading-[1.55] text-white md:text-[15px] [text-shadow:0_1px_12px_rgba(0,0,0,0.4)]">
            Càng làm nhiều, càng rõ ràng rằng dịch vụ này không nên chỉ dành cho vòng quanh chúng tôi. Người mua cũng cần nó.
          </p>
          <a
            href={ctaHref}
            class="mt-6 inline-flex items-center gap-1.5 bg-white px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-85"
            target={ctaExternal ? '_blank' : undefined}
            rel={ctaExternal ? 'noopener noreferrer' : undefined}
          >
            <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0 brightness-0" width="12" height="12" />
            {ctaLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pribeh-section {
    z-index: 40;
  }
  .pribeh-scrim {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.22) 45%, transparent 100%);
  }
  .pribeh-line {
    display: block;
    width: fit-content;
    opacity: 0;
    transform: translateY(14px);
    margin-left: calc(var(--indent) * 1.25rem);
  }
  .pribeh-line.is-in {
    animation: pribeh-line-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 220ms);
  }
  @keyframes pribeh-line-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .pribeh-em {
    width: fit-content;
    border-bottom: 2.5px solid #fff;
    padding-bottom: 0.02em;
  }
  .pribeh-body {
    margin-left: 1.25rem;
  }
  @media (min-width: 768px) {
    .pribeh-body {
      margin-left: 2.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pribeh-line {
      opacity: 1;
      transform: none;
    }
    .pribeh-line.is-in {
      animation: none;
    }
  }
</style>

<script>
  function initPribeh() {
    const wrap = document.querySelector('[data-pribeh]');
    if (!wrap) return;
    if (wrap._pribehCleanup) wrap._pribehCleanup();

    const lines = [...wrap.querySelectorAll('.pribeh-line')];
    if (!lines.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      lines.forEach((el) => el.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        lines.forEach((el) => el.classList.add('is-in'));
        io.disconnect();
      },
      { threshold: 0.28 }
    );

    io.observe(wrap);

    wrap._pribehCleanup = () => {
      io.disconnect();
      wrap._pribehCleanup = null;
    };
  }

  initPribeh();
  document.addEventListener('astro:page-load', initPribeh);
</script>
