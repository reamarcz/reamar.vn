<script>
  function initSluzbyVyber() {
    const wrap = document.querySelector('[data-sluzby-vyber]');
    if (!wrap) return;
    if (wrap._sluzbyCleanup) wrap._sluzbyCleanup();

    const items = [...wrap.querySelectorAll('.sluzby-in')];
    if (!items.length) return;

    function onHowClick(event) {
      const btn = event.target.closest('.sluzba-how-hint');
      if (!btn) return;
      if (window.matchMedia('(min-width: 1024px)').matches) return;
      const pair = btn.closest('.sluzba-pair');
      if (!pair) return;
      const open = pair.classList.toggle('is-how-open');
      pair.querySelectorAll('.sluzba-how-hint').forEach(function (el) {
        el.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    wrap.addEventListener('click', onHowClick);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      items.forEach((el) => el.classList.add('is-in'));
      wrap._sluzbyCleanup = () => {
        wrap.removeEventListener('click', onHowClick);
        wrap._sluzbyCleanup = null;
      };
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        items.forEach((el) => el.classList.add('is-in'));
        io.disconnect();
      },
      { threshold: 0.12 }
    );

    io.observe(wrap);

    wrap._sluzbyCleanup = () => {
      io.disconnect();
      wrap.removeEventListener('click', onHowClick);
      wrap._sluzbyCleanup = null;
    };
  }

  initSluzbyVyber();
  document.addEventListener('astro:page-load', initSluzbyVyber);
</script>
