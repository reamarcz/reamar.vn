---
type NavLink = { href: string; label: string; external?: boolean };

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks: NavLink[] = [
  { href: '/#koncept', label: 'Chúng tôi làm gì' },
  { href: '/#aktualne-pripravujeme', label: 'Pre-sale' },
  { href: '/#specializace', label: 'Chuyên môn' },
  { href: '/#o-nas', label: 'Về chúng tôi' },
  { href: '/sluzby#nejcastejsi-otazky', label: 'FAQ' },
];

const sluzbyHref = '/sluzby';
const isCurrent = (href: string) => {
  if (href === '/sluzby' || href.startsWith('/sluzby#')) return pathname === '/sluzby';
  return false;
};
---

<header
  id="header"
  class="sticky inset-x-0 top-0 z-[70] w-full bg-white"
  role="banner"
  data-nav
>
  <div class="nav-bar-inner mx-auto flex h-[80px] w-full max-w-[1440px] items-center justify-between px-5 md:h-[108px] md:px-10 xl:px-14">
    <div class="flex min-w-0 items-center gap-5 md:gap-8">
      <a href="/" class="relative flex shrink-0 items-center" title="Reamar">
        <img
          src="/images/logo-rig-b.svg"
          alt="Reamar"
          width="140"
          height="36"
          class="nav-logo nav-logo-b h-12 w-auto object-contain"
        />
        <img
          src="/images/logo-rig-w.svg"
          alt=""
          width="140"
          height="36"
          class="nav-logo nav-logo-w h-12 w-auto object-contain"
          aria-hidden="true"
        />
      </a>
      <div class="nav-aside hidden min-w-0 md:block" data-nav-aside>
          <div class="nav-live" data-nav-live>
            <p class="nav-muted font-yellix text-[10px] font-medium leading-none text-black/50">Nguồn cung hiện tại tại Praha và vùng phụ cận</p>
            <p class="nav-fg mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-yellix text-[13px] leading-none text-black">
              <span class="nav-live-dot" aria-hidden="true"></span>
              <span class="font-medium">562 dự án</span>
              <span class="nav-muted font-medium text-black/55">9.689 căn</span>
            </p>
          </div>
          <p class="nav-title nav-fg font-yellix text-[13px] font-medium leading-[1.2] text-black" data-nav-title aria-hidden="true">
            Đại diện người mua<br />
            trên thị trường chủ đầu tư
          </p>
        </div>
    </div>

    <nav class="hidden items-center gap-5 xl:gap-9 lg:flex" aria-label="Chính">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'nav-fg font-yellix text-[14px] text-black no-underline whitespace-nowrap transition-opacity hover:opacity-70',
            isCurrent(link.href) ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}

      <a
        href={sluzbyHref}
        class:list={[
          'nav-cta inline-flex items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] text-white no-underline whitespace-nowrap transition-opacity hover:opacity-85',
          isCurrent('/sluzby') ? 'font-semibold' : 'font-medium',
        ]}
        aria-current={isCurrent('/sluzby') ? 'page' : undefined}
      >
        <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
        Chọn dịch vụ
      </a>
    </nav>

    <button
      type="button"
      class="nav-fg flex h-10 w-10 items-center justify-center border-0 bg-transparent p-0 text-black lg:hidden"
      aria-expanded="false"
      aria-controls="menu-drawer"
      aria-label="Menu"
      data-nav-toggle
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<div
  id="menu-drawer"
  class="fixed inset-0 z-[60] pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
  data-menu-drawer
>
  <button
    type="button"
    class="absolute inset-0 bg-black/85 opacity-0 transition-opacity duration-300 data-[open]:opacity-100 pointer-events-none data-[open]:pointer-events-auto"
    data-drawer-backdrop
    aria-label="Đóng menu"
  ></button>
  <div
    class="absolute right-0 top-0 bottom-0 flex w-full max-w-[360px] min-h-0 flex-col bg-white opacity-0 translate-x-full transition-all duration-300 pointer-events-auto data-[open]:opacity-100 data-[open]:translate-x-0 z-10"
    data-drawer-panel
  >
    <button
      type="button"
      class="flex shrink-0 items-center justify-end gap-2 px-6 pt-6 pb-4 w-full border-0 bg-transparent cursor-pointer hover:opacity-80"
      aria-label="Đóng menu"
      data-drawer-close
    >
      <span class="font-yellix text-[14px] font-medium text-black">Đóng</span>
      <span class="relative flex h-10 w-10 shrink-0 items-center justify-center">
        <span class="absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-current"></span>
        <span class="absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 -translate-y-1/2 -rotate-45 bg-current"></span>
      </span>
    </button>

    <nav class="flex flex-1 flex-col gap-5 overflow-y-auto px-8 pb-4 pt-2" aria-label="Chính">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'font-yellix text-[21px] leading-tight text-black no-underline hover:opacity-70',
            isCurrent(link.href) ? 'font-semibold' : 'font-medium',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          data-drawer-close
        >
          {link.label}
        </a>
      ))}

      <a
        href={sluzbyHref}
        class:list={[
          'mt-4 inline-flex w-fit items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] text-white no-underline',
          isCurrent('/sluzby') ? 'font-semibold' : 'font-medium',
        ]}
        aria-current={isCurrent('/sluzby') ? 'page' : undefined}
        data-drawer-close
      >
        <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
        Chọn dịch vụ
      </a>
    </nav>

    <div class="mt-auto shrink-0 border-t border-black/10 px-8 pb-8 pt-6">
      <div class="flex flex-col gap-4">
        <a
          href="https://wa.me/420607066044"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex w-fit items-center gap-3"
          data-drawer-close
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </span>
          <span class="font-yellix text-[16px] font-medium text-black transition-opacity group-hover:opacity-70">Nhắn tin</span>
        </a>
        <button
          type="button"
          class="group flex w-fit items-center gap-3 border-0 bg-transparent p-0 text-left"
          data-smart-contact-open
          data-smart-contact-type="client"
          data-drawer-close
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10M7 12h10M7 17h6"/></svg>
          </span>
          <span class="font-yellix text-[16px] font-medium text-black transition-opacity group-hover:opacity-70">Form liên hệ</span>
        </button>
        <button
          type="button"
          class="group flex w-fit items-center gap-3 border-0 bg-transparent p-0 text-left"
          data-smart-meeting-open
          data-smart-meeting-type="client"
          data-drawer-close
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center text-black transition-opacity group-hover:opacity-70">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <span class="font-yellix text-[16px] font-medium text-black transition-opacity group-hover:opacity-70">Gặp trực tiếp tại Praha hoặc online</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-logo-w {
    display: none;
  }
  [data-nav-overlay]:not([data-nav-solid]) {
    background: transparent;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-logo-b {
    display: none;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-logo-w {
    display: block;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-fg,
  [data-nav-overlay]:not([data-nav-solid]) .nav-title {
    color: #fff;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-muted {
    color: rgba(255, 255, 255, 0.68);
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-aside {
    border-left-color: rgba(255, 255, 255, 0.28);
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-cta {
    background: #fff;
    color: #000;
  }
  [data-nav-overlay]:not([data-nav-solid]) .nav-cta img {
    filter: brightness(0);
  }
  [data-nav-overlay][data-nav-solid] {
    background: #fff;
  }
  .nav-aside {
    position: relative;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
    padding-left: 2rem;
    transition: border-color 0.6s ease, padding-left 0.6s ease;
  }
  [data-nav-compact] .nav-aside {
    border-left-color: transparent;
    padding-left: 0;
  }
  .nav-title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .nav-live {
    transition: opacity 0.5s ease 0.12s;
  }
  [data-nav-compact] .nav-live {
    opacity: 0;
    pointer-events: none;
    transition-delay: 0s;
  }
  [data-nav-compact] .nav-title {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0.16s;
  }
  [data-nav] {
    transition: box-shadow 0.6s ease, background-color 0.35s ease;
  }
  [data-nav-compact] {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-live,
    .nav-title {
      transition: none;
    }
  }
  .nav-live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.45);
    animation: nav-live-pulse 2.2s ease-in-out infinite;
  }
  @keyframes nav-live-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.45); }
    50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(22, 163, 74, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-live-dot { animation: none; }
  }
</style>

<script>
  (function () {
    if (!document.querySelector('[data-nav]')) return;

    function openDrawer() {
      var drawer = document.querySelector('[data-menu-drawer]');
      var backdrop = document.querySelector('[data-drawer-backdrop]');
      var panel = document.querySelector('[data-drawer-panel]');
      var toggle = document.querySelector('[data-nav-toggle]');
      if (!drawer || !backdrop) return;
      drawer.setAttribute('data-open', '');
      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('data-open', '');
      if (panel) panel.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      var drawer = document.querySelector('[data-menu-drawer]');
      var backdrop = document.querySelector('[data-drawer-backdrop]');
      var panel = document.querySelector('[data-drawer-panel]');
      var toggle = document.querySelector('[data-nav-toggle]');
      if (!drawer || !backdrop) return;
      drawer.removeAttribute('data-open');
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.removeAttribute('data-open');
      if (panel) panel.removeAttribute('data-open');
      document.body.style.overflow = '';
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-nav-toggle]')) {
        e.preventDefault();
        var toggle = document.querySelector('[data-nav-toggle]');
        if (toggle?.getAttribute('aria-expanded') === 'true') closeDrawer();
        else openDrawer();
        return;
      }
      if (e.target.closest('[data-drawer-backdrop]')) { closeDrawer(); return; }
      if (e.target.closest('[data-drawer-close]')) { closeDrawer(); return; }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var drawer = document.querySelector('[data-menu-drawer]');
      if (drawer?.hasAttribute('data-open')) closeDrawer();
    });

    document.addEventListener('astro:after-swap', function () {
      var drawer = document.querySelector('[data-menu-drawer]');
      if (drawer?.hasAttribute('data-open')) closeDrawer();
    });

    var compactOnScroll = null;
    function setNavCompact(on) {
      var header = document.querySelector('[data-nav]');
      var live = document.querySelector('[data-nav-live]');
      var title = document.querySelector('[data-nav-title]');
      if (!header) return;
      if (on) header.setAttribute('data-nav-compact', '');
      else header.removeAttribute('data-nav-compact');
      if (live) live.setAttribute('aria-hidden', on ? 'true' : 'false');
      if (title) title.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    function setNavSolid(on) {
      var header = document.querySelector('[data-nav]');
      if (!header) return;
      if (on) header.setAttribute('data-nav-solid', '');
      else header.removeAttribute('data-nav-solid');
    }
    function initNavCompact() {
      if (compactOnScroll) {
        window.removeEventListener('scroll', compactOnScroll);
        compactOnScroll = null;
      }
      var header = document.querySelector('[data-nav]');
      var aside = document.querySelector('[data-nav-aside]');
      if (!header) {
        setNavCompact(false);
        setNavSolid(false);
        return;
      }
      compactOnScroll = function () {
        var y = window.scrollY;
        var overlay = header.hasAttribute('data-nav-overlay');

        if (overlay || !aside) {
          setNavCompact(false);
        } else {
          var on = header.hasAttribute('data-nav-compact');
          if (!on && y > 48) setNavCompact(true);
          else if (on && y < 16) setNavCompact(false);
        }

        if (overlay) {
          var banner = document.querySelector('[data-agent-banner]');
          if (banner) {
            setNavSolid(banner.getBoundingClientRect().bottom <= header.offsetHeight + 4);
          }
        } else {
          setNavSolid(false);
        }
      };
      compactOnScroll();
      window.addEventListener('scroll', compactOnScroll, { passive: true });
    }
    initNavCompact();
    document.addEventListener('astro:page-load', initNavCompact);
  })();
</script>
