---
interface Props {
  ctaHref?: string;
}

const { ctaHref = '/sluzby' } = Astro.props;
const image = '/images/agency/int-14-scaled.webp';
---

<section id="prilezitosti" class="relative w-full overflow-hidden" aria-labelledby="prilezitosti-heading">
  <div class="relative min-h-[480px] h-[68vh] max-h-[760px] w-full">
    <img
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[center_46%]"
      width="2560"
      height="2560"
      loading="lazy"
    />

    <div class="relative mx-auto flex h-full max-w-[1440px] items-end px-5 pb-12 md:px-10 md:pb-16 xl:px-14 xl:pb-[4.5rem]">
      <div class="max-w-[36rem]">
        <h2
          id="prilezitosti-heading"
          class="font-yellix text-[22px] font-medium leading-[1.22] tracking-[-0.02em] text-white md:text-[28px] xl:text-[32px] [text-shadow:0_1px_16px_rgba(0,0,0,0.28)]"
        >
          Chúng tôi đưa bạn đến những cơ hội<br />
          mà người mua thông thường không thấy.
        </h2>
        <a
          href={ctaHref}
          class="mt-5 inline-flex items-center gap-1.5 bg-white px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-85"
        >
          <img
            src="/images/arrow-1.svg"
            alt=""
            class="h-3 w-3 shrink-0 brightness-0"
            width="12"
            height="12"
          />
          Chọn dịch vụ
        </a>
      </div>
    </div>
  </div>
</section>
