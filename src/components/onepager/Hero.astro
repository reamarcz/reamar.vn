<script>
  function initHeroWordRotate() {
    if (window.__heroWordTimeoutId) {
      clearTimeout(window.__heroWordTimeoutId);
      window.__heroWordTimeoutId = null;
    }
    const el = document.querySelector('[data-hero-word]');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const words = ['kupující', 'investory', 'klienty'];
    let i = 0;
    const DISPLAY_MS = 2200;
    const SWAP_MS = 320;

    function tick() {
      if (!document.body.contains(el)) return;
      el.classList.add('is-out');
      setTimeout(function () {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove('is-out');
        el.classList.add('is-in');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            el.classList.remove('is-in');
          });
        });
      }, SWAP_MS);
      window.__heroWordTimeoutId = setTimeout(tick, DISPLAY_MS);
    }

    window.__heroWordTimeoutId = setTimeout(tick, DISPLAY_MS);
  }

  initHeroWordRotate();
  document.addEventListener('astro:page-load', initHeroWordRotate);
</script>

