    transform-origin: center center;
    transition: color 0.3s ease, transform 0.35s ease;
  }
  .hero-process-icon svg {
    width: 18px;
    height: 18px;
  }
  .hero-process-label {
    font-family: 'Yellix', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    color: rgba(0, 0, 0, 0.42);
    max-width: 12ch;
    transform-origin: top center;
    transition: color 0.3s ease, transform 0.35s ease;
  }
  .hero-process-step.is-active .hero-process-icon {
    color: #0b6e4f;
    transform: scale(1.14);
  }
  .hero-process-step.is-active .hero-process-label {
    color: #0b6e4f;
    transform: scale(1.08);
  }
  .hero-process-step.is-done .hero-process-label {
    color: #000;
  }
  .hero-process-step.is-done .hero-process-icon {
    color: #000;
    transform: scale(1);
  }
  @keyframes hero-process-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-process-step {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-process-track-fill,
    .hero-process-icon,
    .hero-process-label {
      transition: none;
    }
    .hero-process-step.is-active .hero-process-icon,
    .hero-process-step.is-active .hero-process-label {
      transform: none;
    }
  }
</style>

<script>
  function initHeroWordRotate() {
    if (window.__heroWordTimeoutId) {
      clearTimeout(window.__heroWordTimeoutId);
      window.__heroWordTimeoutId = null;
    }
    const el = document.querySelector('[data-hero-word]');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const words = ['người mua', 'nhà đầu tư', 'khách hàng'];
    let i = 0;
    const DISPLAY_MS = 2200;
    const SWAP_MS = 320;

    function tick() {
      if (!document.body.contains(el)) return;
      el.classList.add('is-out');
      setTimeout(function () {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove('is-out');
        el.classList.add('is-in');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            el.classList.remove('is-in');
          });
        });
      }, SWAP_MS);
      window.__heroWordTimeoutId = setTimeout(tick, DISPLAY_MS);
    }

    window.__heroWordTimeoutId = setTimeout(tick, DISPLAY_MS);
  }

  initHeroWordRotate();
  document.addEventListener('astro:page-load', initHeroWordRotate);

  function initHeroPrepRotate() {
    if (window.__heroPrepTimeoutId) {
      clearTimeout(window.__heroPrepTimeoutId);
      window.__heroPrepTimeoutId = null;
    }
    const roots = [...document.querySelectorAll('[data-hero-prep]')];
    if (!roots.length) return;

    let items = [];
    try {
      items = JSON.parse(roots[0].getAttribute('data-hero-prep-items') || '[]');
    } catch (e) {
      items = [];
    }
    if (!Array.isArray(items) || items.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const words = roots
      .map(function (root) { return root.querySelector('[data-hero-prep-word]'); })
      .filter(Boolean);
    if (!words.length) return;

    let i = 0;
    const DISPLAY_MS = 2800;
    const SWAP_MS = 300;

    function tick() {
      if (!words.some(function (el) { return document.body.contains(el); })) return;
      words.forEach(function (el) { el.classList.add('is-out'); });
      setTimeout(function () {
        i = (i + 1) % items.length;
        words.forEach(function (el) {
          el.textContent = items[i];
          el.classList.remove('is-out');
          el.classList.add('is-in');
        });
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            words.forEach(function (el) { el.classList.remove('is-in'); });
          });
        });
      }, SWAP_MS);
      window.__heroPrepTimeoutId = setTimeout(tick, DISPLAY_MS);
    }

    window.__heroPrepTimeoutId = setTimeout(tick, DISPLAY_MS);
  }

  initHeroPrepRotate();
  document.addEventListener('astro:page-load', initHeroPrepRotate);

  function initHeroProcess() {
    if (window.__heroProcessIntervalId) {
      clearInterval(window.__heroProcessIntervalId);
      window.__heroProcessIntervalId = null;
    }
    const root = document.querySelector('[data-hero-process]');
    if (!root) return;
    const steps = root.querySelectorAll('[data-hero-process-step]');
    const fill = root.querySelector('[data-hero-process-fill]');
    if (!steps.length) return;

    function paint(activeIndex) {
      steps.forEach(function (step, index) {
        step.classList.toggle('is-active', index === activeIndex);
        step.classList.toggle('is-done', index < activeIndex);
      });
      if (fill) {
        const max = Math.max(steps.length - 1, 1);
        fill.style.width = ((activeIndex / max) * 100) + '%';
      }
    }

    let active = 0;
    paint(active);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      steps.forEach(function (step) { step.classList.add('is-done'); step.classList.remove('is-active'); });
      steps[steps.length - 1]?.classList.add('is-active');
      if (fill) fill.style.width = '100%';
      return;
    }

    window.__heroProcessIntervalId = setInterval(function () {
      active = (active + 1) % steps.length;
      paint(active);
    }, 2400);
  }

  initHeroProcess();
  document.addEventListener('astro:page-load', initHeroProcess);
</script>

