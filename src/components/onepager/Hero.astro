---
interface Cta {
  href: string;
  label: string;
  primary?: boolean;
}

interface Props {
  image?: string;
  playLabel?: string;
  em?: string;
  line2?: string;
  title?: [string, string, string];
  titleEmBreak?: boolean;
  titleEmGreen?: boolean;
  actionCardGreen?: boolean;
  lead?: string;
  ctas?: Cta[];
  proof?: 'market' | 'offer';
  storyHref?: string;
  storyKicker?: string;
  storyTitle?: string;
  storyYt?: boolean;
  storyMeeting?: boolean;
  showPlay?: boolean;
  showProcess?: boolean;
  actionKicker?: string;
  actionMeta?: string;
  actionCta?: string;
  actionHref?: string;
  actionImage?: string;
  actionPlacement?: 'photo' | 'clients' | 'copy' | 'none' | 'signal';
  eyebrow?: string;
  cueAfterCtas?: boolean;
  cueHref?: string;
  copyLift?: boolean;
  prepTicker?: boolean;
  prepItems?: { title: string; subtitle: string }[];
  mobileImage?: string;
}

const {
  image: heroImage = '/images/agency/jv-holder3.jpg',
  playLabel = 'Phát video',
  em = 'người mua',
  line2 = 'trên thị trường chủ đầu tư',
  title,
  titleEmBreak = false,
  titleEmGreen = false,
  actionCardGreen = false,
  lead,
  ctas = [
    { href: '/investice', label: 'Tôi là nhà đầu tư' },
    { href: '/bydleni', label: 'Tôi tìm nhà ở', primary: true },
  ],
  proof = 'market',
  storyHref = '/#pribehy-z-trhu',
  storyKicker = 'Câu chuyện từ thị trường',
  storyTitle = 'Agent cho người mua',
  storyYt = true,
  storyMeeting = false,
  showPlay = true,
  showProcess = false,
  actionKicker = 'Sắp mở pre-sale',
  actionMeta = 'Malešice | tháng 9/2026',
  actionCta = 'Tôi muốn tham gia',
  actionHref = '/#presale',
  actionImage = '/images/zizkov.webp',
  actionPlacement = 'photo',
  eyebrow,
  cueAfterCtas = false,
  cueHref = '/#koncept',
  copyLift = false,
  prepTicker = false,
  prepItems = [
    { title: 'Vinohrady', subtitle: 'căn nhỏ' },
    { title: 'Holešovice', subtitle: 'căn đầu tư' },
    { title: 'Vršovice', subtitle: 'dự án lớn' },
    { title: 'Karlín', subtitle: 'ba dự án mới' },
  ],
  mobileImage = '/images/agency/Georgemob.webp',
} = Astro.props;

const leadHtml = lead ?? null;
const actionExternal = actionHref.startsWith('http');
const prepLabels = prepItems.map((item) => `${item.title} · ${item.subtitle}`);

const processSteps = [
  {
    title: 'Tư vấn ban đầu',
    icon: 'chat',
  },
  {
    title: 'Tìm kiếm cá nhân',
    icon: 'search',
  },
  {
    title: 'Đàm phán với chủ đầu tư',
    icon: 'building',
  },
] as const;
---

<section class="hero relative w-full overflow-hidden bg-white" aria-label="Mở đầu">
  <div class="hero-visual pointer-events-none absolute inset-y-0 right-0 z-[5] hidden w-[72%] overflow-hidden lg:block">
    <img
      src={heroImage}
      alt=""
      class="hero-visual-img absolute left-0 top-0 h-auto w-full"
      width="2500"
      height="1877"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-fade pointer-events-none absolute inset-y-0 left-0 w-[32%]" aria-hidden="true"></div>
    <div class="pointer-events-auto absolute inset-0">
      {showPlay && (
      <button
        type="button"
        class="hero-play absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 rounded-full bg-white/80 px-4 py-2 font-yellix text-[13px] font-medium text-black backdrop-blur-[12px] transition-opacity hover:opacity-85"
      >
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
          <path d="M3.2 1.6v8.8L10.4 6 3.2 1.6Z"/>
        </svg>
        {playLabel}
      </button>
      )}

      <div class="hero-corner absolute right-8 bottom-8 flex flex-col items-end gap-2.5 md:right-10 md:bottom-10">
        {actionPlacement === 'photo' && (
        <a
          href={actionHref}
          class:list={['hero-action-card', actionCardGreen && 'hero-action-card-green']}
          target={actionExternal ? '_blank' : undefined}
          rel={actionExternal ? 'noopener noreferrer' : undefined}
        >
          <img
            src={actionImage}
            alt=""
            class="hero-action-photo"
            width="96"
            height="96"
          />
          <span class="hero-action-copy">
            <span class="hero-action-kicker">{actionKicker}</span>
            <span class="hero-action-meta">{actionMeta}</span>
            <span class="hero-action-cta">
              <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
              {actionCta}
            </span>
          </span>
        </a>
        )}
        <div class="hero-agent-stack">
        <div class="hero-agent-card">
          <p class="hero-agent-name">George</p>
          <p class="hero-agent-role">Đại diện của bạn khi mua căn hộ</p>
          <div class="hero-agent-contacts">
            <a
              class="hero-agent-contact"
              href="https://wa.me/420722546666"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="hero-agent-wa" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.41 2.15 11.84c0 1.99.59 3.85 1.6 5.42L2 22l4.9-1.58a9.9 9.9 0 0 0 5.14 1.42h.01c5.46 0 9.89-4.41 9.89-9.84C21.94 6.41 17.5 2 12.04 2Zm5.76 14.03c-.24.67-1.4 1.23-1.94 1.31-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.79-4.18-4.93-4.37-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.09 1-2.37.26-.28.57-.35.76-.35h.55c.18 0 .41-.06.64.49.24.56.81 1.97.88 2.11.07.14.12.31.02.5-.1.19-.14.31-.28.48-.14.16-.3.37-.42.49-.14.14-.28.29-.12.56.16.28.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.14.43.12.59-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.61-.14.24.09 1.55.73 1.81.86.27.14.44.2.51.31.07.11.07.64-.17 1.31Z"/>
              </svg>
              <span>722 546 666</span>
            </a>
            <a class="hero-agent-contact" href="mailto:george@reamar.cz">
              george@reamar.cz
            </a>
          </div>
          {storyMeeting && (
            <button
              type="button"
              class="hero-agent-cta"
              data-smart-meeting-open
              data-smart-meeting-type="client"
            >
              <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
              Đặt lịch gặp trực tiếp
            </button>
          )}
        </div>
        {prepTicker && prepLabels.length > 0 && (
          <a
            href="#aktualne-pripravujeme"
            class="hero-prep"
            data-hero-prep
            data-hero-prep-items={JSON.stringify(prepLabels)}
          >
            <span class="hero-prep-kicker">
              <span class="hero-prep-dot" aria-hidden="true"></span>
              Đang chuẩn bị
            </span>
            <span class="hero-prep-line">
              <span class="hero-prep-rotate" aria-live="polite">
                <span class="hero-prep-sizer" aria-hidden="true">
                  {prepLabels.reduce((a, b) => (a.length >= b.length ? a : b))}
                </span>
                <span class="hero-prep-word" data-hero-prep-word>{prepLabels[0]}</span>
              </span>
              <img
                src="/images/arrow-1.svg"
                alt=""
                class="hero-prep-arrow"
                width="11"
                height="11"
              />
            </span>
          </a>
        )}
        </div>
        {!storyMeeting && (
        <a href={storyHref} class="hero-story-card">
          {storyYt ? (
            <span class="hero-story-yt" aria-hidden="true">
              <svg viewBox="0 0 24 17">
                <path fill="#FF0000" d="M23.5 2.65A3.02 3.02 0 0 0 21.38.5C19.5 0 12 0 12 0S4.5 0 2.62.5A3.02 3.02 0 0 0 .5 2.65 31.9 31.9 0 0 0 0 8.5a31.9 31.9 0 0 0 .5 5.85 3.02 3.02 0 0 0 2.12 2.15C4.5 17 12 17 12 17s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.15A31.9 31.9 0 0 0 24 8.5a31.9 31.9 0 0 0-.5-5.85Z"/>
                <path fill="#fff" d="M9.75 12.15V4.85L15.7 8.5 9.75 12.15Z"/>
              </svg>
            </span>
          ) : (
            <span class="hero-story-yt hero-story-yt-static" aria-hidden="true">
              <img src="/images/arrow-1.svg" alt="" width="12" height="12" />
            </span>
          )}
          <span class="hero-story-copy">
            <span class="hero-story-kicker">{storyKicker}</span>
            <span class="hero-story-title">{storyTitle}</span>
          </span>
        </a>
        )}
      </div>
    </div>
  </div>

  <div class="hero-stage pointer-events-none relative mx-auto flex max-w-[1440px] flex-col lg:min-h-[calc(100svh-108px)]">
    <div class="hero-copy pointer-events-auto relative z-10 flex w-full flex-1 flex-col px-5 py-8 md:px-10 lg:w-[44%] xl:px-14">
      <div class:list={['flex flex-1 flex-col justify-center', titleEmBreak ? 'hero-copy-tight' : showProcess ? '' : copyLift ? 'lg:-translate-y-20' : actionPlacement === 'copy' ? '' : 'lg:-translate-y-5']}>
      {actionPlacement === 'copy' && (
        <a
          href={actionHref}
          class:list={['hero-action-card mb-6 w-fit md:mb-8', actionCardGreen && 'hero-action-card-green']}
          target={actionExternal ? '_blank' : undefined}
          rel={actionExternal ? 'noopener noreferrer' : undefined}
        >
          <img
            src={actionImage}
            alt=""
            class="hero-action-photo"
            width="96"
            height="96"
          />
          <span class="hero-action-copy">
            <span class="hero-action-kicker">{actionKicker}</span>
            <span class="hero-action-meta">{actionMeta}</span>
            <span class="hero-action-cta">
              <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
              {actionCta}
            </span>
          </span>
        </a>
      )}
      {eyebrow && (
        <p class="mb-3 font-yellix text-[13px] font-medium uppercase leading-snug tracking-[0.08em] text-black md:mb-4 md:text-[14px]">
          {eyebrow}
        </p>
      )}
      <h1 class:list={['font-yellix text-[36px] font-medium leading-[1.08] tracking-[-0.025em] text-black sm:text-[46px] xl:text-[52px]', title && (title[1] || title[2]) && 'hero-title-stack']}>
        {title ? (
          titleEmBreak ? (
            <>
              <span class="hero-title-lead">{title[0]}</span>
              <span class:list={['hero-title-emline', titleEmGreen && 'hero-title-em-green']}><span class="hero-em">{title[1]}</span></span>
              <span class="hero-title-sub">{title[2]}</span>
            </>
          ) : title[1] || title[2] ? (
            <>
              <span class="hero-title-lead">
                {title[0]}{title[1] && <span class="hero-em">{title[1]}</span>}
              </span>
              {title[2] && <span class="hero-title-sub">{title[2]}</span>}
            </>
          ) : (
            title[0]
          )
        ) : (
          <>
            Chúng tôi đại diện{' '}
            <span class="hero-rotate" aria-live="polite">
              <span class="hero-rotate-sizer" aria-hidden="true">nhà đầu tư</span>
              <span class="hero-em hero-rotate-word" data-hero-word>{em}</span>
            </span>
            <br />
            <span class:list={[line2 === 'trên thị trường chủ đầu tư' && 'whitespace-nowrap']}>{line2}</span>
          </>
        )}
      </h1>
      {leadHtml ? (
        <p class="mt-4 max-w-[42ch] font-yellix text-[14px] font-medium leading-[1.5] text-black/80 md:text-[15px]">
          {leadHtml}
        </p>
      ) : (
        <p class="mt-4 max-w-[68ch] font-yellix text-[14px] font-medium leading-[1.5] text-black/80 md:text-[15px]">
          <span class="block md:whitespace-nowrap">Có đội ngũ riêng khi mua căn hộ dự án.</span>
          Theo dõi thị trường, chọn căn phù hợp và đàm phán<br />
          với chủ đầu tư bên cạnh bạn.
        </p>
      )}

      <div class:list={['mt-6 flex flex-wrap items-center', cueAfterCtas ? 'gap-x-4 gap-y-2' : 'gap-2']}>
        {ctas.map((cta) => (
          cta.primary ? (
            <a
              href={cta.href}
              class="inline-flex items-center gap-1.5 bg-black px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-white no-underline transition-opacity hover:opacity-85"
            >
              <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0" width="12" height="12" />
              {cta.label}
            </a>
          ) : (
            <a
              href={cta.href}
              class="inline-flex items-center border border-black bg-white px-3 py-1.5 font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-70"
            >
              {cta.label}
            </a>
          )
        ))}
        {cueAfterCtas && (
          <a href={cueHref} class="font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-70">
            Chúng tôi làm gì
          </a>
        )}
      </div>

      {proof === 'market' && !cueAfterCtas && (
        <div class="mt-10">
          <p class="font-yellix text-[13px] font-medium uppercase leading-snug tracking-[0.08em] text-black md:text-[14px]">
            Đại diện người mua căn hộ dự án mới
          </p>
          <a href="/#koncept" class="hero-scroll-cue mt-2 inline-flex w-fit items-center gap-1.5 font-yellix text-[14px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-85 md:text-[15px]">
            <img src="/images/arrow-1.svg" alt="" class="h-3 w-3 shrink-0 brightness-0" width="12" height="12" />
            <span>Chúng tôi làm gì</span>
          </a>
        </div>
      )}

      {proof === 'offer' && (
        <div class="mt-10">
          <p class="font-yellix text-[13px] font-medium leading-none text-black md:text-[14px]">Bảng chào bán cá nhân hóa trông như thế nào</p>
          <a
            href="#"
            class="hero-offer-btn mt-3 inline-flex w-fit items-center gap-2 font-yellix text-[13px] font-medium leading-none text-black no-underline transition-opacity hover:opacity-85 md:text-[14px]"
          >
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 3.5h8.5L19 7v13.5H7V3.5Z"/>
              <path d="M15.5 3.5V7H19"/>
              <circle cx="12.2" cy="14.2" r="3.1"/>
              <path d="m14.4 16.4 2.3 2.3"/>
            </svg>
            <span>Chi tiết chào bán</span>
          </a>
        </div>
      )}

      {showProcess && (
        <div class="hero-process-wrap">
          <p class="hero-process-heading">Cách hoạt động</p>
          <div class="hero-process" data-hero-process>
            <div class="hero-process-track" aria-hidden="true">
              <span class="hero-process-track-base"></span>
              <span class="hero-process-track-fill" data-hero-process-fill></span>
            </div>
            <ol class="hero-process-list" aria-label="Cách hoạt động">
              {processSteps.map((step, index) => (
                <li
                  class:list={['hero-process-step', index === 0 && 'is-active']}
                  style={`--i: ${index}`}
                  data-hero-process-step
                >
                  <span class="hero-process-icon" aria-hidden="true">
                    {step.icon === 'chat' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6.2h9.2A1.8 1.8 0 0 1 15 8v5.2a1.8 1.8 0 0 1-1.8 1.8H9.4L6.2 18v-3H4A1.8 1.8 0 0 1 2.2 13.2V8A1.8 1.8 0 0 1 4 6.2Z"/>
                        <path d="M15.4 9.2H19A1.8 1.8 0 0 1 20.8 11v5.2A1.8 1.8 0 0 1 19 18h-2.2V20l-2.6-2"/>
                      </svg>
                    )}
                    {step.icon === 'search' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="6.2"/>
                        <path d="M16.2 16.2 21 21"/>
                      </svg>
                    )}
                    {step.icon === 'building' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 21V5.5A1.5 1.5 0 0 1 6.5 4h7A1.5 1.5 0 0 1 15 5.5V21"/>
                        <path d="M15 10h3.5A1.5 1.5 0 0 1 20 11.5V21"/>
                        <path d="M3.5 21h17"/>
                        <path d="M8 8h2M8 11.5h2M8 15h2M17 14h1.2M17 17.5h1.2"/>
                      </svg>
                    )}
                  </span>
                  <span class="hero-process-label">{step.title}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}

      </div>
    </div>
    {actionPlacement !== 'copy' && actionPlacement !== 'none' && (
    <div class="hero-clients pointer-events-auto z-10 flex items-center gap-2.5 px-5 pt-8 md:px-10 lg:absolute lg:bottom-10 lg:left-10 lg:min-h-[44px] lg:px-0 lg:pt-0 xl:left-14">
      {actionPlacement === 'signal' ? (
        <a
          href={actionHref}
          class="hero-offer-signal"
          target={actionExternal ? '_blank' : undefined}
          rel={actionExternal ? 'noopener noreferrer' : undefined}
        >
          <img
            src={actionImage}
            alt=""
            class="hero-offer-signal-photo"
            width="64"
            height="64"
          />
          <span class="hero-offer-signal-copy">
            <span class="hero-offer-signal-kicker">{actionKicker}</span>
            <span class="hero-offer-signal-meta">
              {actionMeta}
              <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
            </span>
          </span>
        </a>
      ) : actionPlacement === 'clients' ? (
        <a
          href={actionHref}
          class:list={['hero-action-card', actionCardGreen && 'hero-action-card-green']}
          target={actionExternal ? '_blank' : undefined}
          rel={actionExternal ? 'noopener noreferrer' : undefined}
        >
          <img
            src={actionImage}
            alt=""
            class="hero-action-photo"
            width="96"
            height="96"
          />
          <span class="hero-action-copy">
            <span class="hero-action-kicker">{actionKicker}</span>
            <span class="hero-action-meta">{actionMeta}</span>
            <span class="hero-action-cta">
              <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
              {actionCta}
            </span>
          </span>
        </a>
      ) : (
        <>
          <div class="flex -space-x-1.5" aria-hidden="true">
            <span class="hero-avatar h-7 w-7 rounded-full ring-2 ring-white" style="background:#d7d2c8"></span>
            <span class="hero-avatar h-7 w-7 rounded-full ring-2 ring-white" style="background:#c3beb4"></span>
            <span class="hero-avatar h-7 w-7 rounded-full ring-2 ring-white" style="background:#a8a29a"></span>
          </div>
          <p class="font-yellix text-[10px] font-medium uppercase leading-[1.25] tracking-[0.08em] text-black">
            150+ khách hàng<br />hài lòng
          </p>
        </>
      )}
    </div>
    )}

    <div class="hero-mobile-block pointer-events-auto mt-2 w-full lg:hidden">
      <div class="hero-mobile-visual relative w-full overflow-hidden">
        <img
          src={mobileImage}
          alt=""
          class="hero-mobile-img h-full w-full object-cover object-[center_20%]"
          width="1200"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
        {showPlay && (
        <button
          type="button"
          class="hero-play absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 rounded-full bg-white/80 px-4 py-2 font-yellix text-[13px] font-medium text-black backdrop-blur-[12px] transition-opacity hover:opacity-85"
        >
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <path d="M3.2 1.6v8.8L10.4 6 3.2 1.6Z"/>
          </svg>
          {playLabel}
        </button>
        )}
      </div>
      <div class="hero-mobile-cards relative z-[2] -mt-14 flex flex-col items-stretch gap-2 px-5 pb-2">
        {actionPlacement === 'photo' && (
        <a
          href={actionHref}
          class:list={['hero-action-card self-stretch', actionCardGreen && 'hero-action-card-green']}
          target={actionExternal ? '_blank' : undefined}
          rel={actionExternal ? 'noopener noreferrer' : undefined}
        >
          <img
            src={actionImage}
            alt=""
            class="hero-action-photo"
            width="96"
            height="96"
          />
          <span class="hero-action-copy">
            <span class="hero-action-kicker">{actionKicker}</span>
            <span class="hero-action-meta">{actionMeta}</span>
            <span class="hero-action-cta">
              <img src="/images/arrow-1.svg" alt="" width="11" height="11" />
              {actionCta}
            </span>
          </span>
        </a>
        )}
        <div class="hero-agent-stack hero-agent-stack-mobile">
        <div class="hero-agent-card">
          <p class="hero-agent-name">George</p>
          <p class="hero-agent-role">Đại diện của bạn khi mua căn hộ</p>
          <div class="hero-agent-contacts">
            <a
              class="hero-agent-contact"
              href="https://wa.me/420722546666"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="hero-agent-wa" viewBox="0 0 24 24" aria-hidden="true">
