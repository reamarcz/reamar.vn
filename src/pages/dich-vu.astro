import SectionFaq from '../components/onepager/SectionFaq.astro';
import SectionFooter from '../components/onepager/SectionFooter.astro';
---
<OnepagerLayout
  title="Chọn dịch vụ | REAMAR"
  description="Chọn dịch vụ đại diện người mua: theo dõi dự án, tìm kiếm căn hộ hoặc đại diện trọn gói khi mua dự án mới."
