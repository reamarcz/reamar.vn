---
import OnepagerLayout from '../layouts/OnepagerLayout.astro';
import Hero from '../components/onepager/Hero.astro';
import SectionBuyersAgency from '../components/onepager/SectionBuyersAgency.astro';
import SectionPrilecitosti from '../components/onepager/SectionPrilecitosti.astro';
import SectionSpecializace from '../components/onepager/SectionSpecializace.astro';
import SectionNasPribeh from '../components/onepager/SectionNasPribeh.astro';
import SectionPorovnani from '../components/onepager/SectionPorovnani.astro';
import SectionZastoupeni from '../components/onepager/SectionZastoupeni.astro';
import SectionVyberSluzeb from '../components/onepager/SectionVyberSluzeb.astro';
import SectionFaq from '../components/onepager/SectionFaq.astro';
import SectionFooter from '../components/onepager/SectionFooter.astro';
---
<OnepagerLayout
  title="Agentura pro kupující | REAMAR"
  description="Zastupujeme kupující na developerském trhu. Sledujeme trh, vybíráme vhodné jednotky a jednáme s developerem na vaší straně."
  robots="noindex, nofollow, noarchive"
>
  <Hero
    image="/images/agency/onepager.webp"
    storyHref="#vyber-sluzeb"
    storyKicker="Ceník služeb"
    storyTitle="Jak to funguje"
    storyYt={false}
    showPlay={false}
    actionKicker="Aktuální předprodej"
    actionMeta="Vinohrady | září 2026"
    actionHref="https://nabidka.reamar.cz/vinohrady"
    actionImage="/images/agency/vinohrady.webp"
    actionPlacement="clients"
    actionCardGreen={true}
    ctas={[{ href: '#vyber-sluzeb', label: 'Vybrat službu', primary: true }]}
    eyebrow="Nákupní agentura pro novostavby"
    cueAfterCtas={true}
    cueHref="#koncept"
    copyLift={true}
  />
  <SectionBuyersAgency ctaHref="#vyber-sluzeb" />
  <SectionPrilecitosti ctaHref="#vyber-sluzeb" />
  <SectionSpecializace showSoftwarePlay={false} />
  <SectionNasPribeh
    ctaHref="https://www.reamar.cz/"
    ctaLabel="O Reamar Invest Group"
  />
  <SectionPorovnani ctaHref="#vyber-sluzeb" />
  <SectionZastoupeni />
  <SectionVyberSluzeb headingAs="h2" compactTop={false} />
  <SectionFaq />
  <SectionFooter faqHref="#nejcastejsi-otazky" />
</OnepagerLayout>
