---
import OnepagerLayout from '../layouts/OnepagerLayout.astro';
import Hero from '../components/onepager/Hero.astro';
import SectionBuyersAgency from '../components/onepager/SectionBuyersAgency.astro';
import SectionPrilecitosti from '../components/onepager/SectionPrilecitosti.astro';
import SectionSpecializace from '../components/onepager/SectionSpecializace.astro';
import SectionNasPribeh from '../components/onepager/SectionNasPribeh.astro';
import SectionPorovnani from '../components/onepager/SectionPorovnani.astro';
import SectionAktualnePripravujeme from '../components/onepager/SectionAktualnePripravujeme.astro';
import SectionFooter from '../components/onepager/SectionFooter.astro';

const canonical = 'https://www.reamar.vn/';
const ogImage = '/images/agency/og.png';
const ogImageAlt = 'George, người đại diện hỗ trợ khách hàng mua căn hộ tại Praha bằng tiếng Việt';
---
<OnepagerLayout
  title="Mua căn hộ mới tại Praha | Đại diện bên mua"
  description="Tìm căn hộ mới tại Praha để ở hoặc đầu tư. Đại diện bên mua, đàm phán với chủ đầu tư và tiếp cận giỏ hàng trước khi mở bán. Tư vấn bằng tiếng Việt."
  ogTitle="Mua căn hộ tại Praha, có người đồng hành cùng bạn"
  ogDescription="Từ lựa chọn căn hộ đến đàm phán và ký hợp đồng, chúng tôi đồng hành cùng bạn bằng tiếng Việt. Đặt lịch gặp để trao đổi nhu cầu và tìm hiểu các dự án phù hợp."
  image={ogImage}
  imageAlt={ogImageAlt}
  canonical={canonical}
  ogType="website"
  locale="vi_VN"
  hreflang={[
    { lang: 'vi', href: canonical },
    { lang: 'x-default', href: canonical },
  ]}
>
  <Hero
    image="/images/agency/georgereamar.webp"
    title={['Đại diện cho bạn khi mua căn hộ mới tại Praha', '', '']}
    lead="Tư vấn mua nhà bằng tiếng Việt. Giúp bạn mua căn hộ mới tại Praha để ở hoặc đầu tư — đại diện bên mua bất động sản, đàm phán với chủ đầu tư và tiếp cận giỏ hàng trước khi mở bán trên các căn hộ dự án tại Praha."
    storyHref="#"
    storyKicker="Gặp trực tiếp"
    storyTitle="Đặt lịch gặp trực tiếp"
    storyYt={false}
    storyMeeting={true}
    showPlay={false}
    showProcess={true}
    actionPlacement="none"
    ctas={[{ href: '/sluzby', label: 'Chọn dịch vụ', primary: true }]}
    eyebrow="Đại diện người mua căn hộ dự án mới"
    cueAfterCtas={true}
    cueHref="#koncept"
    copyLift={false}
    prepTicker={true}
  />
  <SectionBuyersAgency />
  <SectionPrilecitosti />
  <SectionAktualnePripravujeme />
  <SectionSpecializace showSoftwarePlay={false} />
  <SectionNasPribeh
    ctaHref="https://www.reamar.cz/"
    ctaLabel="Về Reamar Invest Group"
  />
  <SectionPorovnani />
  <SectionFooter />
</OnepagerLayout>
